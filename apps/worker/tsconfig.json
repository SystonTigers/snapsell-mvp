{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "rootDir": "src",
    "types": ["@cloudflare/workers-types", "vitest/globals"],
    "baseUrl": "./src",
    "paths": {
      "@snapsell/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src", "test"],
  "exclude": ["node_modules"]
}
