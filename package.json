{
  "name": "snapsell-mvp",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:conflicts": "node scripts/check-conflicts.mjs"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.6",
    "prettier": "3.3.3",
    "turbo": "2.2.3"
  },
  "pnpm": {
    "packageExtensions": {
      "itty-router@4.0.23": {
        "dependencies": {
          "itty-router": "4.0.23"
        }
      }
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
