{
  "name": "snapsell-mvp",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "check:conflicts": "git diff --check",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "dev": "pnpm dev:all",
    "dev:all": "pnpm -w run dev:worker & pnpm -w run dev:web",
    "dev:worker": "pnpm --filter snapsell-worker dev",
    "dev:web": "pnpm --filter snapsell-web dev",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.6",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "tsx": "^4.17.0",
    "vitest": "^2.1.3"
  },
  "pnpm": {
    "packageExtensions": {
      "itty-router@4.0.23": {
        "dependencies": {
          "itty-router": "4.0.23"
        }
      }
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
